# --max-nodes-total=99 leaves 95 autoscaler nodes after 1 control plane and
# 3 agents: 1 + 3 + 95 + 1 ingress load balancer = 100 attachments, so the plan
# passes although max_nodes alone would need 105.
cluster_autoscaler_version    = "v1.35.0"
cluster_autoscaler_extra_args = ["--max-nodes-total=99"]

agent_nodepools = [
  {
    name        = "agent"
    server_type = "cx23"
    location    = "nbg1"
    labels      = []
    taints      = []
    count       = 3
    os          = "leapmicro"
  }
]

autoscaler_nodepools = [
  {
    name        = "autoscaled"
    server_type = "cx23"
    location    = "nbg1"
    min_nodes   = 0
    max_nodes   = 100
  }
]
